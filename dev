#!/usr/bin/env bash
# =============================================================================
#  ./dev — atalho para tudo no projeto (feito para WSL/Ubuntu + Docker)
#
#   ./dev build          compila (padrão se rodar só ./dev)
#   ./dev run [exe|cue]  compila COM o registro de partida e abre na cópia portátil do
#                        DuckStation Linux; o TTY vai para logs/partida-AAAAMMDD-HHMM.txt
#   ./dev run --sem-registro [exe|cue]  build normal no emulador do dev.conf
#   ./dev analisar-partida [arquivo]   resumo legível do último registro de partida
#   ./dev economia [N]   munição/mana/cura x inimigos por fase, no PC (N sementes)
#   ./dev robo [N]       o robô joga N sementes x 4 fases x 3 personagens (sem janela)
#   ./dev robo-test       24 partidas do robô: a lógica mudou? (hash de g no fim)
#   ./dev capturas        telas do menu em docs/capturas/ (o robô joga e fotografa)
#   ./dev models         exporta os .blend de assets/blender/ para models/ (Blender do Windows)
#   ./dev watch          recompila sozinho sempre que você salvar um arquivo
#   ./dev clean          apaga a pasta build/
#   ./dev shell          abre um terminal dentro do ambiente de compilação
#   ./dev image          (re)cria a imagem Docker do SDK
#   ./dev vram           mostra onde cada textura ficou na VRAM
#   ./dev bench          mede FPS/POLIS/COL sozinho no DuckStation Linux (build-bench/)
#   ./dev mapgen-test [N] testa o gerador de florestas no PC (N sementes por fase)
#   ./dev events-test [N] testa os eventos no PC
#   ./dev replay-test     partida roteirizada: a lógica mudou? (hash de g)
#   ./dev doctor         confere se está tudo instalado
#
#  Por padrão usa Docker. Se você instalou o SDK direto no Ubuntu
#  (scripts/setup-linux.sh), coloque USE_DOCKER=0 no dev.conf.
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

IMAGE="psx-arena-sdk"
USE_DOCKER=1
EMULATOR=""
EMULATOR_ARGS=""
RUN_FILE="cue"
BLENDER=""
SDK_DIR="/opt/psn00bsdk"
DUCKSTATION_LINUX="$HOME/emuladores/duckstation/AppRun"   # ./dev bench
DUCKSTATION_DATA="$HOME/.local/share/duckstation"         # de onde vêm config e BIOS
BENCH_TIMEOUT=${BENCH_TIMEOUT:-300}                         # segundos

# Configuração pessoal (não vai para o git)
if [[ ! -f dev.conf && -f dev.conf.example ]]; then
	cp dev.conf.example dev.conf
fi
# shellcheck disable=SC1091
[[ -f dev.conf ]] && source dev.conf

c_ok()   { printf '\033[32m%s\033[0m\n' "$*"; }
c_info() { printf '\033[36m%s\033[0m\n' "$*"; }
c_err()  { printf '\033[31m%s\033[0m\n' "$*" >&2; }

is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

# ---------------------------------------------------------------------------
# Ambiente de compilação
# ---------------------------------------------------------------------------
need_docker() {
	if ! command -v docker >/dev/null 2>&1; then
		c_err "Docker não encontrado."
		c_err "No Windows: instale o Docker Desktop e ative Settings > Resources > WSL Integration > Ubuntu."
		c_err "Ou, dentro do Ubuntu:  sudo apt install docker.io && sudo usermod -aG docker \$USER  (e reabra o terminal)"
		exit 1
	fi
	if ! docker info >/dev/null 2>&1; then
		c_err "O Docker está instalado mas não está respondendo."
		c_err "Abra o Docker Desktop no Windows (ou rode: sudo service docker start)."
		exit 1
	fi
}

ensure_image() {
	need_docker
	if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
		c_info "Criando a imagem Docker do SDK (só na primeira vez, alguns minutos)..."
		docker build -t "$IMAGE" "$ROOT"
	fi
}

# Roda um comando no ambiente do SDK. No Docker, a pasta do projeto é montada
# no MESMO caminho de dentro do WSL, assim mensagens de erro apontam para os
# arquivos certos (e o VS Code consegue abrir com um clique).
sdk() {
	if [[ "$USE_DOCKER" == "1" ]]; then
		ensure_image
		local tty=()
		if [[ "${SDK_INTERACTIVE:-0}" == "1" ]]; then tty=(-i); [[ -t 0 && -t 1 ]] && tty=(-it); fi
		docker run --rm "${tty[@]}" \
			--user "$(id -u):$(id -g)" \
			-e HOME=/tmp \
			-v "$ROOT":"$ROOT" -w "$ROOT" \
			"$IMAGE" "$@"
	else
		export PSN00BSDK_LIBS="$SDK_DIR/lib/libpsn00b"
		export PATH="$SDK_DIR/bin:$PATH"
		"$@"
	fi
}

target_triple() {
	if [[ "$USE_DOCKER" != "1" ]] && command -v mipsel-none-elf-gcc >/dev/null 2>&1; then
		echo mipsel-none-elf
	else
		echo mipsel-linux-gnu
	fi
}

# Esconde mensagens repetitivas e inofensivas (use VERBOSE=1 ./dev build para ver tudo)
quiet_filter() {
	if [[ "${VERBOSE:-0}" == "1" ]]; then cat; return; fi
	awk '
		/^MKPSXISO/ { iso = 1 }
		iso { if ($0 ~ /rror/) print; if ($0 ~ /^Total image size/) iso = 0; next }
		/linking abicalls files with non-abicalls|uses -msoft-float|note\.gnu\.build-id/ { next }
		{ print; fflush() }'
}

cmd_build() {
	local t; t="$(target_triple)"
	sdk sh -c "
		if [ ! -f build/build.ninja ]; then
			cmake --preset default -DPSN00BSDK_TARGET=$t > build-config.log 2>&1 || { cat build-config.log; exit 1; }
			rm -f build-config.log
		fi
		cmake --build ./build
	" 2>&1 | quiet_filter || { c_err "A compilação falhou (veja o erro acima)."; return 1; }

	# Cabeçalhos do SDK para o autocompletar do VS Code (uma vez)
	if [[ ! -d .sdk/include ]]; then
		mkdir -p .sdk
		if [[ "$USE_DOCKER" == "1" ]]; then
			sdk cp -r /opt/psn00bsdk/include .sdk/ 2>/dev/null || true
		else
			cp -r "$SDK_DIR/include" .sdk/ 2>/dev/null || true
		fi
	fi
	c_ok "OK: build/arena.exe  build/arena.cue  ($(stat -c %s build/arena.exe) bytes)"
}

cmd_clean() {
	rm -rf build
	c_ok "build/ apagada."
}

# ---------------------------------------------------------------------------
# Emulador (programa do Windows chamado de dentro do WSL)
# ---------------------------------------------------------------------------
win_path() {
	if is_wsl; then wslpath -w "$1"; else echo "$1"; fi
}

# Cópia PORTÁTIL do DuckStation Linux (build-bench/duckstation): a sua
# instalação e a sua pasta de dados nunca são tocadas; da sua configuração
# (controles, BIOS) só LEMOS o settings.ini. mode = bench | jogar.
portable_ds() {
	local mode="$1"
	if [[ ! -x "$DUCKSTATION_LINUX" ]]; then
		c_err "DuckStation Linux não encontrado em $DUCKSTATION_LINUX (mude DUCKSTATION_LINUX no dev.conf)."
		return 1
	fi
	local ds="$ROOT/build-bench/duckstation"
	local src_dir; src_dir="$(dirname "$DUCKSTATION_LINUX")"
	if [[ ! -e "$ds/AppRun" ]]; then
		c_info "Copiando o DuckStation para build-bench/duckstation (só na primeira vez)..."
		mkdir -p "$ROOT/build-bench"
		cp -a "$src_dir" "$ds" || return 1
	fi
	local exe_dir; exe_dir="$(dirname "$(readlink -f "$ds/AppRun")")"
	touch "$exe_dir/portable.txt"
	local flag=""
	[[ "$mode" == "jogar" ]] && flag="--jogar"
	python3 "$ROOT/tools/bench_settings.py" $flag "$DUCKSTATION_DATA/settings.ini" \
		"$exe_dir/settings.ini" "$DUCKSTATION_DATA/bios" || return 1
	echo "$ds"
}

# Build com o registro de partida (DEBUG_PLAYLOG) em build-debug/
cmd_build_debug() {
	local t bdir="build-debug"
	t="$(target_triple)"
	c_info "Compilando com o registro de partida em $bdir/..."
	sdk sh -c "
		if [ ! -f $bdir/build.ninja ]; then
			cmake --preset default -B $bdir -DPSN00BSDK_TARGET=$t -DARENA_PLAYLOG=ON > $bdir-config.log 2>&1 || { cat $bdir-config.log; exit 1; }
			rm -f $bdir-config.log
		fi
		cmake --build ./$bdir
	" 2>&1 | quiet_filter || { c_err "A compilação com registro falhou."; return 1; }
	c_ok "OK: $bdir/arena.exe  $bdir/arena.cue"
}

cmd_run() {
	local registro=1 what="$RUN_FILE"
	for a in "$@"; do
		case "$a" in
			--sem-registro) registro=0 ;;
			exe|cue) what="$a" ;;
			*) c_err "Uso: ./dev run [--sem-registro] [exe|cue]"; return 1 ;;
		esac
	done

	if (( ! registro )); then                     # build normal, emulador do dev.conf
		cmd_build
		local file="$ROOT/build/arena.$what"
		if [[ -z "$EMULATOR" ]]; then
			c_err "Emulador não configurado. Edite o arquivo dev.conf e preencha EMULATOR."
			c_info "Enquanto isso, abra no emulador:  $file"
			exit 1
		fi
		if [[ ! -e "$EMULATOR" ]]; then
			c_err "Não achei o emulador em: $EMULATOR  (confira o dev.conf)"
			exit 1
		fi
		# emulador do Windows (.exe) recebe o caminho no formato do Windows
		local arg="$file"
		[[ "$EMULATOR" == *.exe ]] && arg="$(win_path "$file")"
		c_info "Abrindo $(basename "$file") no emulador (sem registro)..."
		# shellcheck disable=SC2086
		( cd "$(dirname "$EMULATOR")" && "$EMULATOR" $EMULATOR_ARGS "$arg" >/dev/null 2>&1 & )
		return 0
	fi

	# COM registro (etapa 07b): build-debug/ com DEBUG_PLAYLOG, cópia portátil,
	# TTY gravado em logs/partida-AAAAMMDD-HHMM.txt
	local bdir="build-debug"
	cmd_build_debug || return 1
	local ds; ds="$(portable_ds jogar | tail -1)" || return 1
	mkdir -p "$ROOT/logs"
	local log; log="$ROOT/logs/partida-$(date +%Y%m%d-%H%M).txt"
	c_info "Abrindo no DuckStation (cópia portátil, com os seus controles)..."
	c_ok "Registro: ${log#$ROOT/}  (feche o emulador para terminar; depois: ./dev analisar-partida)"
	(
		"$ds/AppRun" -fastboot -- "$ROOT/$bdir/arena.$what" 2>&1 |
			sed -u 's/\x1b\[[0-9;]*m//g' | grep --line-buffered -o "TTY: .*" |
			sed -u 's/^TTY: //' > "$log"
	) &
}

# ---------------------------------------------------------------------------
# Blender
# ---------------------------------------------------------------------------
find_blender() {
	if [[ -n "$BLENDER" ]]; then echo "$BLENDER"; return; fi
	if is_wsl; then
		local b
		b=$(ls -d /mnt/c/Program\ Files/Blender\ Foundation/Blender*/blender.exe 2>/dev/null | sort -V | tail -1 || true)
		[[ -n "$b" ]] && { echo "$b"; return; }
	fi
	command -v blender 2>/dev/null || true
}

cmd_models() {
	local blender; blender="$(find_blender)"
	if [[ -z "$blender" ]]; then
		c_err "Blender não encontrado. Instale no Windows ou preencha BLENDER no dev.conf."
		exit 1
	fi
	shopt -s nullglob
	local files=(assets/blender/*.blend)
	if (( ${#files[@]} == 0 )); then
		c_err "Nenhum .blend em assets/blender/."
		exit 1
	fi
	for f in "${files[@]}"; do
		c_info "Exportando $f ..."
		"$blender" --background "$(win_path "$ROOT/$f")" \
			--python "$(win_path "$ROOT/tools/export_blend.py")" -- \
			--models "$(win_path "$ROOT/models")" \
			--textures "$(win_path "$ROOT/assets/textures")" 2>&1 \
			| grep -E "^(PSX|ERRO|Erro|Error)" || true
	done
	c_ok "Modelos exportados. Agora: ./dev build"
}

# ---------------------------------------------------------------------------
# Outros
# ---------------------------------------------------------------------------
cmd_watch() {
	c_info "Observando src/ models/ assets/ — salve um arquivo para recompilar (Ctrl+C sai)."
	local last=""
	while true; do
		local now
		now=$(find src models assets CMakeLists.txt iso.xml -type f -printf '%T@ %p\n' 2>/dev/null | sort | md5sum)
		if [[ "$now" != "$last" ]]; then
			[[ -n "$last" ]] && { c_info "--- mudança detectada $(date +%T) ---"; cmd_build || true; }
			last="$now"
		fi
		sleep 1
	done
}

cmd_shell() {
	c_info "Terminal do SDK (digite exit para sair)."
	SDK_INTERACTIVE=1 sdk bash
}

cmd_image() {
	need_docker
	docker build -t "$IMAGE" "$ROOT"
	c_ok "Imagem $IMAGE pronta."
}

cmd_vram() {
	[[ -f build/textures/vram.txt ]] && cat build/textures/vram.txt || c_err "Compile primeiro (./dev build)."
}

cmd_doctor() {
	echo "Projeto:   $ROOT"
	if [[ "$ROOT" == /mnt/* ]]; then
		c_err "  Aviso: o projeto está no disco do Windows (/mnt/...). Fica MUITO mais rápido em ~/ (disco do Linux)."
	fi
	is_wsl && c_ok "WSL:       sim" || echo "WSL:       não"
	if [[ "$USE_DOCKER" == "1" ]]; then
		if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
			c_ok "Docker:    ok"
			docker image inspect "$IMAGE" >/dev/null 2>&1 && c_ok "Imagem:    $IMAGE ok" || echo "Imagem:    será criada no primeiro ./dev build"
		else
			c_err "Docker:    não disponível (veja ./dev build para instruções)"
		fi
	else
		[[ -d "$SDK_DIR/lib/libpsn00b" ]] && c_ok "SDK local: $SDK_DIR" || c_err "SDK local: não encontrado em $SDK_DIR"
	fi
	if [[ -z "$EMULATOR" ]]; then
		c_err "Emulador:  não configurado (EMULATOR no dev.conf)"
	elif [[ ! -e "$EMULATOR" ]]; then
		c_err "Emulador:  não encontrado: $EMULATOR (dev.conf)"
	elif [[ "$EMULATOR" == *.exe ]]; then
		c_ok "Emulador:  $EMULATOR (Windows)"
	elif [[ -x "$EMULATOR" ]]; then
		c_ok "Emulador:  $EMULATOR (Linux)"
	else
		c_err "Emulador:  $EMULATOR não é executável"
	fi
	[[ -x "$DUCKSTATION_LINUX" ]] && c_ok "Registro:  DuckStation Linux $DUCKSTATION_LINUX (cópia portátil em build-bench/)" \
		|| c_err "Registro:  DuckStation Linux não encontrado em $DUCKSTATION_LINUX (./dev run e ./dev bench precisam)"
	[[ -f "$DUCKSTATION_DATA/settings.ini" ]] && c_ok "Controles: $DUCKSTATION_DATA/settings.ini (só lido)" \
		|| echo "Controles: $DUCKSTATION_DATA/settings.ini não existe (a cópia usa o padrão)"
	local b; b="$(find_blender)"
	[[ -n "$b" ]] && c_ok "Blender:   $b" || echo "Blender:   não encontrado (opcional)"
}

# ---------------------------------------------------------------------------
# Benchmark automático: compila com DEBUG_BENCHMARK numa pasta separada
# (build-bench/, o build normal nunca fica com o modo ligado), roda no
# DuckStation Linux com o log da TTY no console, espera "BENCH FIM", fecha
# o emulador e mostra a tabela. Resultado bruto em build-bench/bench.txt.
# ---------------------------------------------------------------------------
cmd_bench() {
	local t; t="$(target_triple)"
	# ./dev bench -D NOME=VALOR ...: variante com definições extras (ex.:
	# TREE_LOD_DIST=1300), compilada em build-bench-var/ sem mexer no config.h
	local defs="" bdir="build-bench"
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-D) defs="${defs:+$defs;}$2"; shift 2 ;;
			-D*) defs="${defs:+$defs;}${1#-D}"; shift ;;
			*) c_err "Uso: ./dev bench [-D NOME=VALOR ...]"; return 1 ;;
		esac
	done
	[[ -n "$defs" ]] && bdir="build-bench-var"
	c_info "Compilando com DEBUG_BENCHMARK em $bdir/ ${defs:+(com $defs)}..."
	sdk sh -c "
		if [ ! -f $bdir/build.ninja ] || [ -n '$defs' ]; then
			cmake --preset default -B $bdir -DPSN00BSDK_TARGET=$t -DARENA_BENCHMARK=ON -DARENA_BENCH_DEFS='$defs' > $bdir-config.log 2>&1 || { cat $bdir-config.log; exit 1; }
			rm -f $bdir-config.log
		fi
		cmake --build ./$bdir
	" 2>&1 | quiet_filter || { c_err "A compilação do benchmark falhou."; return 1; }

	# Configuração ISOLADA: cópia portátil (portable_ds), velocidade ilimitada
	local ds; ds="$(portable_ds bench | tail -1)" || return 1
	local log="$ROOT/$bdir/bench.log" out="$ROOT/$bdir/bench.txt"
	rm -f "$log" "$out"
	local before; before="$(ls -laR --time-style=full-iso "$DUCKSTATION_DATA" 2>/dev/null | md5sum)"

	c_info "Rodando no DuckStation (até ${BENCH_TIMEOUT}s)..."
	"$ds/AppRun" -earlyconsole -batch -fastboot -nogui -- "$ROOT/$bdir/arena.cue" > "$log" 2>&1 &
	local pid=$! waited=0
	while (( waited < BENCH_TIMEOUT )); do
		grep -q "BENCH FIM" "$log" 2>/dev/null && break
		kill -0 "$pid" 2>/dev/null || break
		sleep 1; waited=$((waited + 1))
	done
	# SIGKILL: o fechamento "educado" às vezes trava; a cópia não guarda nada útil
	kill -9 "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true

	if [[ "$(ls -laR --time-style=full-iso "$DUCKSTATION_DATA" 2>/dev/null | md5sum)" != "$before" ]]; then
		c_err "AVISO: algo mudou em $DUCKSTATION_DATA durante o benchmark (deveria ficar intacto)."
	fi
	sed 's/\x1b\[[0-9;]*m//g' "$log" | grep -o "BENCH .*" | tr -d '\r' > "$out" || true
	if ! grep -q "BENCH FIM" "$out"; then
		c_err "Não chegou o BENCH FIM (tempo esgotado ou emulador fechou). Log: build-bench/bench.log"
		tail -20 "$log"
		return 1
	fi
	awk '
		/^BENCH ponto=/ {
			for (i = 2; i <= NF; i++) { split($i, kv, "="); v[kv[1]] = kv[2] }
			printf "%-12s %4s %4s | %4s %4s | %5s %5s | %6s | %5s %4s | %4s %4s | %5s | %4s %4s %5s | %3s | %4s %4s %4s\n",
				v["ponto"], v["inimigos_extra"], v["inimigos_total"], v["fps_min"], v["fps_med"],
				v["polis_max"], v["polis_med"], v["ram_gpu_max"], v["col_max"], v["col_med"],
				v["arvores_modelo"], v["arvores_plana"], (v["grade_erros"] == "" ? "-" : v["grade_erros"]),
				(v["cam_max"] == "" ? "-" : v["cam_max"]), (v["cam_med"] == "" ? "-" : v["cam_med"]),
				(v["cam_celulas_max"] == "" ? "-" : v["cam_celulas_max"]),
				(v["arvores_transp"] == "" ? "-" : v["arvores_transp"]),
				(v["cpu_med"] == "" ? "-" : v["cpu_med"]), (v["gpu_espera_med"] == "" ? "-" : v["gpu_espera_med"]),
				(v["logica_med"] == "" ? "-" : v["logica_med"])
			delete v
		}
		BEGIN {
			printf "%-12s %4s %4s | %4s %4s | %5s %5s | %6s | %5s %4s | %4s %4s | %5s | %4s %4s %5s | %3s | %4s %4s %4s\n",
				"ponto", "+ini", "ini", "fps", "fps", "polis", "polis", "RAMGPU", "COL", "COL", "arv", "arv", "grade", "CAM", "CAM", "CAM", "arv", "CPU", "GPU", "LOG"
			printf "%-12s %4s %4s | %4s %4s | %5s %5s | %6s | %5s %4s | %4s %4s | %5s | %4s %4s %5s | %3s | %4s %4s %4s\n",
				"", "", "", "min", "med", "max", "med", "max", "max", "med", "mod", "pla", "erros", "max", "med", "cel", "50%", "lin", "esp", "lin"
		}' "$out"
	c_ok "Resultado bruto: $bdir/bench.txt"
}

# ---------------------------------------------------------------------------
# Teste do gerador no PC: compila o código real (mapgen/level/levels/...)
# para o PC com gcc (dentro do Docker) e roda N sementes por fase.
# ---------------------------------------------------------------------------
cmd_mapgen_test() {
	local n="1000" bench="" defs=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--bench) bench="--bench"; shift ;;
			-D) defs="$defs -D$2"; shift 2 ;;
			-D*) defs="$defs $1"; shift ;;
			*) n="$1"; shift ;;
		esac
	done
	[[ -f build/gen/assets_gen.c ]] || cmd_build >/dev/null || return 1
	local out; out="$(mktemp)"
	sdk sh -c "
		I=$SDK_DIR/include/libpsn00b
		gcc -O2 -w -DHOST_TEST $defs -include stdlib.h -I src -I models -I build/gen -I \$I \
			-o build/mapgen_test tools/mapgen_test.c src/mapgen.c src/level.c src/levels.c \
			src/collision.c src/rng.c src/data.c src/mathutil.c src/reach.c build/gen/assets_gen.c \
			-Wl,--unresolved-symbols=ignore-all 2> build/mapgen_test.log ||
			{ cat build/mapgen_test.log >&2; echo 'mapgen-test: a compilacao falhou' >&2; exit 1; }
		grep -v 'relocation against\\|DT_TEXTREL' build/mapgen_test.log >&2
		./build/mapgen_test $n $bench
	" > "$out" || { cat "$out"; rm -f "$out"; return 1; }
	grep -v '^BENCHSEEDS:' "$out"
	if [[ -n "$bench" ]]; then
		grep '^BENCHSEEDS:' "$out" | sed 's/^BENCHSEEDS://' > src/bench_seeds.h
		c_ok "gravado: src/bench_seeds.h (5 piores sementes por fase para o ./dev bench)"
	fi
	rm -f "$out"
}

cmd_events_test() {
	local n="300" defs=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-D) defs="$defs -D$2"; shift 2 ;;
			-D*) defs="$defs $1"; shift ;;
			*) n="$1"; shift ;;
		esac
	done
	[[ -f build/gen/assets_gen.c ]] || cmd_build >/dev/null || return 1
	# liga SEM ignorar símbolos: um stub esquecido vira erro, não segfault
	sdk sh -c "
		I=$SDK_DIR/include/libpsn00b
		gcc -O2 -w -DHOST_TEST $defs -include stdlib.h -I src -I models -I build/gen -I \$I \
			-o build/events_test tools/events_test.c src/events.c src/reach.c src/mapgen.c \
			src/level.c src/levels.c src/collision.c src/rng.c src/data.c src/mathutil.c \
			build/gen/assets_gen.c -lm -ffunction-sections -fdata-sections -Wl,--gc-sections \\
			2> build/events_test.log ||
			{ grep -v 'relocation against\\|DT_TEXTREL' build/events_test.log >&2; echo 'events-test: a compilacao falhou' >&2; exit 1; }
		./build/events_test $n
	"
}

# Partida roteirizada com hash (etapa 10a): mesma semente + mesmas entradas
# = mesmo jogo. Roda o build de bench com -D BENCH_REPLAY e compara os hashes
# de g a cada 10 s com tools/replay_ref.txt. Rode SEMPRE que mexer na lógica.
#   ./dev replay-test           compara com a referência
#   ./dev replay-test --save    grava a referência atual (só se a mudança de
#                               lógica foi intencional e explicada)
cmd_replay_test() {
	local save=0 extra=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--save) save=1; shift ;;
			-D) extra+=(-D "$2"); shift 2 ;;
			-D*) extra+=("$1"); shift ;;
			*) c_err "Uso: ./dev replay-test [--save] [-D NOME=VALOR]"; return 1 ;;
		esac
	done
	cmd_bench -D BENCH_REPLAY=1 "${extra[@]}" > build-replay.log 2>&1 ||
		{ cat build-replay.log; c_err "O replay não terminou (log: build-replay.log)"; return 1; }
	local got ref="$ROOT/tools/replay_ref.txt"
	got="$(grep '^BENCH REPLAY' "$ROOT/build-bench-var/bench.txt" | sed 's/^BENCH REPLAY //')"
	rm -f build-replay.log
	if [[ -z "$got" ]]; then c_err "Nenhuma linha de hash saiu do replay."; return 1; fi
	if (( save )); then
		printf '%s\n' "$got" > "$ref"
		c_ok "Referência gravada: tools/replay_ref.txt ($(wc -l < "$ref") hashes)"
		return 0
	fi
	if [[ ! -f "$ref" ]]; then c_err "Sem referência: rode ./dev replay-test --save"; return 1; fi
	if diff <(printf '%s\n' "$got") "$ref" > /dev/null; then
		c_ok "REPLAY IGUAL: $(wc -l < "$ref") hashes conferem (a lógica não mudou)"
	else
		c_err "REPLAY DIFERENTE: a lógica mudou. Primeira diferença (atual | referência):"
		diff <(printf '%s\n' "$got") "$ref" | head -6
		return 1
	fi
}

